generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  SHORT_TEXT
  LONG_TEXT
  MULTIPLE_CHOICE
  DROPDOWN
  SCALE
  CHECKBOX
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Question {
  id          String         @id @default(uuid())
  code        String         @unique // Format ID seperti QUE001, QUE002
  questionText String        @db.Text
  dimension   String         // Misal: "Civic Competence", "Identitas Pedagogik"
  type        QuestionType
  status      QuestionStatus @default(DRAFT)
  
  // Konfigurasi Khusus Tipe Scale (opsional jika type == SCALE)
  scaleMin    Int?           @default(1)
  scaleMax    Int?           @default(5)
  scaleMinLabel String?      // Misal: "Sangat Tidak Setuju"
  scaleMaxLabel String?      // Misal: "Sangat Setuju"

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  options     Option[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  label      String?  // Misal: "A", "B", "C", "D"
  text       String
  score      Int      @default(0) // Bobot skor untuk kalkulasi
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model DimensionCategory {
  id          String   @id @default(cuid())
  code        String   @unique // DMS001, DMS002, dst.
  name        String   // Nama Dimensi (misal: Civic Competence)
  description String?  // Deskripsi
  status      QuestionStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompetencyLevel {
  id        String         @id @default(cuid())
  code      String         @unique // LVL001, LVL002, dst.
  name      String         // Nama Level (misal: Novice Civic Educator)
  minScore  Int            // Rentang Skor Minimum (0-100)
  maxScore  Int            // Rentang Skor Maksimum (0-100)
  status    QuestionStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model AssessmentResult {
  id                 String             @id @default(cuid())
  userIdCode         String             @unique // USR001, USR002, dst.
  userName           String             // Nama Pengguna
  institution        String?            // Asal Instansi
  gradeLevel         String?            // Jenjang Mengajar
  city               String?            // Wilayah Kota/Kab
  duration           String?            // Durasi Pengerjaan
  badgeLevel         String             // Level 4, Level 3, dst.
  compositeScore     Int                // Skor Akhir
  dimensionScores    Json?              // Rincian skor 10 Dimensi
  demographicAnswers Json?              // <-- MENYIMPAN 35 JAWABAN DEMOGRAFIS
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  answers            AssessmentAnswer[]
}

model AssessmentAnswer {
  id                 String           @id @default(cuid())
  assessmentResultId String
  questionCode       String           // QUE001, QUE002, dst.
  questionText       String           // Teks Pertanyaan
  selectedAnswer     String           // A. Sangat Setuju, dsb.
  score              Int              // Skor dari jawaban
  createdAt          DateTime         @default(now())
  assessmentResult   AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  name      String   @default("Admin Civix")
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}